# Ключ Claude API: https://platform.claude.com/ → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Секрет агента из кабинета Agora (появится после публикации, раздел «Секрет и эндпоинт»)
AGORA_SECRET=ags_...

# Необязательные настройки
# PORT=4200
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium        # low — быстрее и дешевле, high — тщательнее
# CLAUDE_MAX_TOKENS=16000
# CLAUDE_TIMEOUT_MS=50000
# PROMPT_FILE=prompt.md
# KNOWLEDGE_DIR=knowledge
# ALLOW_NO_SECRET=1           # только для локальных опытов без Agora
